# ---- INKVERSE server configuration (server-only; never shipped to the browser) ----
# Anthropic (story director). Required for Live mode. Either variable name works.
ANTHROPIC_API_KEY=
FABLE_5_1_KEY=
INKVERSE_STORY_MODEL=claude-fable-5-1
# Runware (artwork). Required for Live mode artwork; story can run without it (sketch-only).
RUNWARE_API_KEY=
INKVERSE_PREVIEW_MODEL=runware:400@4                        # FLUX.2 klein 4B (verified AIR id); alt FLUX.1 schnell runware:100@1 (unverified)
INKVERSE_FINAL_MODEL=openai:gpt-image@2.5-flare
INKVERSE_FINAL_MODEL_ALT=openai:gpt-image@2.5-sunburst
INKVERSE_GENERATION_MODE=parallel                      # parallel | reference_refine
# Budgets (USD). Pending (reserved) jobs count against available budget.
INKVERSE_BUDGET_ANTHROPIC_USD=20
INKVERSE_BUDGET_RUNWARE_USD=20
INKVERSE_BUDGET_PER_RUN_USD=5
# Concurrency / timeouts
INKVERSE_IMAGE_CONCURRENCY=2
INKVERSE_IMAGE_TIMEOUT_MS=90000
INKVERSE_STORY_TIMEOUT_MS=60000
INKVERSE_AUTO_RETRY_LIMIT=1
# Server
PORT=8787
INKVERSE_DATA_DIR=./data
